# API base URL including /v1 (not /chat/completions).
AI_LINT_MODEL_BASE_URL=
# Use the model ID or alias configured on your server (e.g. Qwen/Qwen3.6-35B-A3B).
AI_LINT_MODEL_NAME=
# Optional for servers without authentication.
AI_LINT_MODEL_API_KEY=
AI_LINT_MODEL_TIMEOUT_SECS=30
# json_schema (default), json_object, or text. Requires server support for the selected format.
AI_LINT_MODEL_RESPONSE_FORMAT=json_schema
