{
  "name": "@ai-lint/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "bin": { "ai-lint-hook": "dist/cli.js" },
  "files": ["dist", "examples", "README.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "pretest": "cargo build --locked --manifest-path ../../Cargo.toml && npm run build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "zod": "^3.25.0" },
  "devDependencies": { "@types/node": "^24.13.3", "typescript": "~6.0.2" }
}
